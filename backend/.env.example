# DocMind AI Configuration Template

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security
JWT_SECRET=super_secret_jwt_signing_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/docmind_db?retryWrites=true&w=majority

# Groq API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Local Upload Directory
UPLOAD_DIR=./uploads
VECTORS_DIR=./vectors
